# Maintainer: staraepp
#
# Builds the desktop client (dc-client) and the headless dev tool (dc-cli)
# from the tagged source. Install with:
#   makepkg -si
# The token is never part of the package; see docs/LOCAL_VERIFY.md.

pkgname=dc-client
pkgver=0.2.0
pkgrel=1
pkgdesc="Unofficial native Discord client in Rust (early preview)"
arch=('x86_64')
url="https://github.com/staraepp/rust-discord"
license=('MIT')
depends=('gcc-libs' 'glibc' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11' 'wayland'
         'fontconfig' 'freetype2' 'vulkan-icd-loader' 'vulkan-driver')
makedepends=('cargo' 'git')
replaces=('dc-cli')
conflicts=('dc-cli')
# ring ships C/asm objects that do not link with makepkg's LTO flags.
options=('!lto' '!debug')
source=("$pkgname::git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p dc-app -p dc-cli
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/dc-client "$pkgdir/usr/bin/dc-client"
  install -Dm755 target/release/dc-cli "$pkgdir/usr/bin/dc-cli"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 docs/LOCAL_VERIFY.md "$pkgdir/usr/share/doc/$pkgname/LOCAL_VERIFY.md"
  install -Dm644 docs/COSMETICS.md "$pkgdir/usr/share/doc/$pkgname/COSMETICS.md"
}
